{
  "name": "team-quiz-arkanoid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Team-vs-team party game: an Arkanoid pilot per team plays a level each round while the rest of the team plays a Jeopardy-style board and spends credits on a live shop",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/**/*.test.js",
    "serve": "node server/index.js",
    "lan": "npm run build && node server/index.js"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "ws": "^8.21.1"
  }
}
